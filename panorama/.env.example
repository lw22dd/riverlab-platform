# 高德地图 JS API（Web端）Key
# 申请地址：https://console.amap.com/dev/key/app
# 必须在该 Key 的「域名白名单」中加入 localhost / 127.0.0.1（以及线上域名），
# 否则浏览器控制台会报 INVALID_USER_DOMAIN。
VITE_AMAP_KEY=your-amap-js-api-key

# 与 Key 配对的安全密钥（jscode）。高德 JS API 2.0 必填，
# 缺失时通常报 INVALID_USER_SCODE。
VITE_AMAP_SECURITY_KEY=your-amap-security-key

# 仿真主平台首页地址（全景里的「返回仿真首页」按钮会跳到这里）。
# 生产环境与仿真同源，留空即可（默认 '/'）；
# 本地只单独启动全景 Vite 时，默认会跳到 http://localhost:5174/，
# 需要别的地址再显式填写，例如 VITE_SIMULATION_HOME=http://localhost:5174/
VITE_SIMULATION_HOME=
