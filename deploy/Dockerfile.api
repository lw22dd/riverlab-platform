# syntax=docker/dockerfile:1

FROM golang:1.25-alpine AS builder

WORKDIR /src

ENV CGO_ENABLED=0
# 国内网络环境使用 Go 模块代理，避免 proxy.golang.org 超时
ENV GOPROXY=https://goproxy.cn,direct

# 先复制依赖清单，利用 Docker 层缓存
COPY simulation/frontend/simulation/backend/go.mod simulation/frontend/simulation/backend/go.sum ./
RUN go mod download

COPY simulation/frontend/simulation/backend/ ./

RUN go build -trimpath -buildvcs=false -ldflags="-s -w" -o /out/api .

FROM alpine:3.21

RUN apk add --no-cache ca-certificates tzdata \
    && update-ca-certificates

WORKDIR /app

COPY --from=builder /out/api /app/api
COPY simulation/frontend/simulation/backend/config /app/config

RUN mkdir -p /app/logs

EXPOSE 7000

CMD ["/app/api"]
