# syntax=docker/dockerfile:1

FROM node:22-alpine AS builder

WORKDIR /app

# 先复制依赖清单，利用 Docker 层缓存
COPY simulation/frontend/simulation/package.json simulation/frontend/simulation/package-lock.json ./
RUN npm ci

COPY simulation/frontend/simulation/ ./
RUN npm run build

FROM nginx:alpine

COPY --from=builder /app/dist /usr/share/nginx/html
COPY deploy/nginx/gateway.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
