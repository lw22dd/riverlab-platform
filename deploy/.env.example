# 复制为 .env 后按需修改（不要提交真实密钥）：
#   cp .env.example .env

# MySQL
MYSQL_ROOT_PASSWORD=123456

# MinIO
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=admin123456

# JWT（生产环境请替换为随机长字符串）
JWT_SECRET=change-me-to-a-long-random-string

# 全景前端资源/WebSocket 的 API 基地址
# 本机访问保持 http://localhost；部署到域名或局域网 IP 时改成实际地址
VITE_API_BASE_URL=

# 高德地图 JS API（全景地图用；留空则地图不可用）
# 申请地址：https://console.amap.com/dev/key/app
VITE_AMAP_KEY=
VITE_AMAP_SECURITY_KEY=
