# syntax=docker/dockerfile:1

FROM node:22-alpine AS builder

WORKDIR /app

# 先复制依赖清单，利用 Docker 层缓存
COPY panorama/package.json panorama/package-lock.json ./
RUN npm ci

COPY panorama/ ./

# 默认留空，走同源 /api/v1；仅在需要直连独立源站时通过构建参数覆盖
ARG VITE_API_BASE_URL=
ARG VITE_AMAP_KEY=
ARG VITE_AMAP_SECURITY_KEY=
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}
ENV VITE_AMAP_KEY=${VITE_AMAP_KEY}
ENV VITE_AMAP_SECURITY_KEY=${VITE_AMAP_SECURITY_KEY}

RUN npm run build

FROM nginx:alpine

# 全景 SPA 挂载在 /panorama/ 路径下
COPY --from=builder /app/dist /usr/share/nginx/html/panorama
COPY deploy/nginx/panorama.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
